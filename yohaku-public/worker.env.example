# Cloudflare Worker runtime bindings (not VITE_ browser build variables).
# Configure URL as a runtime variable and the publishable/anon key as a Worker secret.
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Alternatively PUBLIC_SUPABASE_ANON_KEY=<anon JWT>.
# Never use service_role, sb_secret_, user access tokens, or forward visitor cookies.
