
{
  "name": "yohaku-literary",
  "main": "./worker/index.js",
  "keep_vars": true,
  "compatibility_date": "2026-10-29",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/works/*",
      "/api/public/*",
      "/export/*"
    ]
  }
}
